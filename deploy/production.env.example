# Runtime Next.js
NODE_ENV="production"
HOSTNAME="127.0.0.1"
PORT="3000"

# Autenticazione e URL pubblico
AUTH_SECRET="SOSTITUIRE_CON_UNA_STRINGA_GENERATA_CON_OPENSSL_RAND_BASE64_32"
AUTH_URL="https://pubblicazioni-social.example.org"
APP_URL="https://pubblicazioni-social.example.org"
ALLOWED_EMAIL_DOMAIN="icbadiatrecenta.edu.it"

# Database persistente, esterno alla directory dell'applicazione
DATABASE_URL="file:/home/dolomiti/apps/pubblicazioni-social/data/pubblicazioni-social.sqlite"

# Server SMTP
SMTP_HOST="smtp.example.org"
SMTP_PORT="587"
SMTP_USER="SOSTITUIRE"
SMTP_PASSWORD="SOSTITUIRE"
SMTP_FROM="Pubblicazioni social <noreply@example.org>"
SMTP_SECURE="false"
SMTP_STARTTLS="true"

# Consegna dei contenuti
SUBMISSION_EMAIL_TO="redazione@example.org"
SUBMISSION_MAX_MB="15"

# OpenRouter
OPENROUTER_API_KEY="SOSTITUIRE"
OPENROUTER_MODEL="deepseek/deepseek-v4-pro"
MANDATORY_HASHTAGS="#ICBadiaTrecenta,#Scuola"
