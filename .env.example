# Authentication and session
AUTH_SECRET="genera-con: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Access control
ALLOWED_EMAIL_DOMAIN="icbadiatrecenta.edu.it"

# SQLite (the directory must live on a persistent disk in production)
DATABASE_URL="file:./data/social-lab.sqlite"

# SMTP magic link
SMTP_HOST="smtp.example.org"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Pubblicazioni social <noreply@example.org>"
SMTP_SECURE="false"
SMTP_STARTTLS="true"

# Final content delivery (the authenticated sender is automatically put in CC)
SUBMISSION_EMAIL_TO="redazione@example.org"
SUBMISSION_MAX_MB="15"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4-pro"
APP_URL="http://localhost:3000"
MANDATORY_HASHTAGS="#ICBadiaTrecenta,#Scuola"
